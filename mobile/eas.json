{
  "cli": {
    "version": "24.7.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "credentialsSource": "remote",
      "node": "22.23.1",
      "pnpm": "10.15.1",
      "env": {
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "fake",
        "EXPO_USE_METRO_REQUIRE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "node": "22.23.1",
      "pnpm": "10.15.1",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "fake",
        "EXPO_USE_METRO_REQUIRE": "1"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "node": "22.23.1",
      "pnpm": "10.15.1",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "stripe",
        "EXPO_USE_METRO_REQUIRE": "1"
      }
    }
  }
}
